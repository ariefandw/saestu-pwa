# ==============================================================================
# SAESTU ENVIRONMENT VARIABLES (.env.example)
# Salin file ini menjadi `.env.local` untuk development lokal.
# ==============================================================================

# ------------------------------------------------------------------------------
# FIREBASE CLIENT CONFIGURATION
# Diperoleh dari Firebase Console > Project Settings > General > Your apps (Web)
# Dipakai di: src/lib/firebase.ts & src/lib/auth-helper.ts
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# ------------------------------------------------------------------------------
# AI & MACHINE LEARNING API KEYS (SERVER-SIDE ONLY)
# JANGAN beri prefix NEXT_PUBLIC_ agar tidak bocor ke client browser!
# ------------------------------------------------------------------------------

# Groq API Key (Dipakai di src/app/api/ai/route.ts untuk rekomendasi menu PMT Llama 3.3)
# Daftar di: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key

# Google Gemini API Key (Dipakai di src/app/api/vision/route.ts untuk OCR timbangan/pengukur)
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key


